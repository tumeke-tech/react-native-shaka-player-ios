{
  "name": "react-native-shaka-player-ios",
  "version": "0.1.0",
  "description": "Shaka Player Embedded component for react-native (iOS only)",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "lib/commonjs",
    "lib/module",
    "lib/typescript",
    "src",
    "ios",
    "RNShakaPlayer.podspec",
    "scripts/install_shaka_framework.rb",
    "README.md"
  ],
  "keywords": [
    "react-native",
    "ios",
    "shaka",
    "shaka-player"
  ],
  "repository": "https://github.com/tumeke-tech/react-native-shaka-player-ios",
  "author": "Sergei Kazakov <kazakov.s.fl@gmail.com> (https://github.com/cmpayc)",
  "license": "MIT",
  "homepage": "https://github.com/tumeke-tech/react-native-shaka-player-ios",
  "codegenConfig": {
    "libraries": [
      {
        "name": "RNShakaPlayerSpec",
        "type": "components",
        "jsSrcsDir": "src"
      }
    ]
  },
  "scripts": {
    "typescript": "tsc --noEmit",
    "build": "bob build"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^7.32.0 || ^8.2.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-native": "0.75.1",
    "react-native-builder-bob": "^0.30.2",
    "release-it": "^17.10.0",
    "typescript": "^5.1.6"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    }
  },
  "packageManager": "yarn@1.22.19"
}
